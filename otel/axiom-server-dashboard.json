{
  "name": "Steward ACS \u2014 server",
  "description": "Host CPU/memory/disk/network (OTel hostmetrics), BEAM vm.metrics, and memory-auditor health from the ACS Events dataset. Heartbeat gaps = downtime; vm.jump events = sudden metric jumps.",
  "owner": "X-AXIOM-EVERYONE",
  "refreshTime": 60,
  "schemaVersion": 2,
  "timeWindowStart": "qr-now-6h",
  "timeWindowEnd": "qr-now",
  "charts": [
    {
      "id": "cpu",
      "type": "TimeSeries",
      "name": "CPU utilization (non-idle)",
      "query": {
        "apl": "`__METRICS_DATASET__`:`system.cpu.utilization`\n| where state != \"idle\" and state != \"interrupt\" and state != \"nice\"\n| align to $__interval using avg\n| group by state using avg",
        "metricsDataset": "__METRICS_DATASET__"
      }
    },
    {
      "id": "mem",
      "type": "TimeSeries",
      "name": "Memory utilization",
      "query": {
        "apl": "`__METRICS_DATASET__`:`system.memory.utilization`\n| where state == \"used\"\n| align to $__interval using avg\n| group using avg",
        "metricsDataset": "__METRICS_DATASET__"
      }
    },
    {
      "id": "load",
      "type": "TimeSeries",
      "name": "Load average",
      "query": {
        "apl": "`__METRICS_DATASET__`:`system.cpu.load_average.1m`\n| align to $__interval using avg\n| group using avg",
        "metricsDataset": "__METRICS_DATASET__"
      }
    },
    {
      "id": "disk",
      "type": "TimeSeries",
      "name": "Filesystem utilization",
      "query": {
        "apl": "`__METRICS_DATASET__`:`system.filesystem.utilization`\n| align to $__interval using avg\n| group by mountpoint using avg",
        "metricsDataset": "__METRICS_DATASET__"
      }
    },
    {
      "id": "net",
      "type": "TimeSeries",
      "name": "Network IO",
      "query": {
        "apl": "`__METRICS_DATASET__`:`system.network.io`\n| align to $__interval using prom::rate\n| group by device, direction using sum",
        "metricsDataset": "__METRICS_DATASET__"
      }
    },
    {
      "id": "beam_mem",
      "type": "TimeSeries",
      "name": "BEAM memory (vm.metrics)",
      "query": {
        "apl": "['__EVENTS_DATASET__']\n| where ['message'] == \"vm.metrics\"\n| summarize avg_memory=avg(['memory_total_bytes']), avg_sched=avg(['scheduler_utilization']) by bin(_time, 1m)"
      }
    },
    {
      "id": "beam_stat",
      "type": "Statistic",
      "name": "BEAM scheduler util (latest)",
      "colorScheme": "Teal",
      "query": {
        "apl": "['__EVENTS_DATASET__']\n| where ['message'] == \"vm.metrics\"\n| summarize v=avg(['scheduler_utilization'])"
      }
    },
    {
      "id": "cgroup_stat",
      "type": "Statistic",
      "name": "Container cgroup CPU (latest)",
      "colorScheme": "Orange",
      "query": {
        "apl": "['__EVENTS_DATASET__']\n| where ['message'] == \"vm.metrics\"\n| summarize v=avg(['cgroup_cpu_utilization'])"
      }
    },
    {
      "id": "heartbeat",
      "type": "TimeSeries",
      "name": "Heartbeat (vm.metrics count) \u2014 gaps = downtime",
      "query": {
        "apl": "['__EVENTS_DATASET__']\n| where ['message'] == \"vm.metrics\"\n| summarize c=count() by bin(_time, 1m)"
      }
    },
    {
      "id": "heartbeat_latest",
      "type": "Statistic",
      "name": "Latest heartbeat (freeze = down)",
      "colorScheme": "Green",
      "query": {
        "apl": "['__EVENTS_DATASET__']\n| where ['message'] == \"vm.metrics\"\n| summarize v=max(_time)"
      }
    },
    {
      "id": "jumps",
      "type": "TimeSeries",
      "name": "Metric jumps (vm.jump)",
      "query": {
        "apl": "['__EVENTS_DATASET__']\n| where ['message'] == \"vm.jump\"\n| summarize c=count() by bin(_time, 1m)"
      }
    },
    {
      "id": "memory_auditor_cycles",
      "type": "TimeSeries",
      "name": "Memory auditor cycles",
      "query": {
        "apl": "['__EVENTS_DATASET__']\n| where ['message'] == \"memory_auditor.cycle\"\n| summarize c=count() by bin(_time, 5m)"
      }
    },
    {
      "id": "memory_auditor_errors",
      "type": "TimeSeries",
      "name": "Memory auditor errors by reason",
      "query": {
        "apl": "['__EVENTS_DATASET__']\n| where ['message'] == \"memory_auditor.audit_error\"\n| summarize c=count() by bin(_time, 5m), ['reason']"
      }
    },
    {
      "id": "memory_auditor_top_memories",
      "type": "Table",
      "name": "Memory auditor errors by memory",
      "query": {
        "apl": "['__EVENTS_DATASET__']\n| where ['message'] == \"memory_auditor.audit_error\"\n| summarize errors=count(), last_seen=max(_time) by ['org'], ['memory_id']\n| top 20 by errors desc"
      }
    }
  ],
  "layout": [
    {
      "i": "cpu",
      "x": 0,
      "y": 0,
      "w": 6,
      "h": 3
    },
    {
      "i": "mem",
      "x": 6,
      "y": 0,
      "w": 6,
      "h": 3
    },
    {
      "i": "load",
      "x": 0,
      "y": 3,
      "w": 4,
      "h": 3
    },
    {
      "i": "disk",
      "x": 4,
      "y": 3,
      "w": 4,
      "h": 3
    },
    {
      "i": "net",
      "x": 8,
      "y": 3,
      "w": 4,
      "h": 3
    },
    {
      "i": "beam_mem",
      "x": 0,
      "y": 6,
      "w": 8,
      "h": 3
    },
    {
      "i": "beam_stat",
      "x": 8,
      "y": 6,
      "w": 2,
      "h": 3
    },
    {
      "i": "cgroup_stat",
      "x": 10,
      "y": 6,
      "w": 2,
      "h": 3
    },
    {
      "i": "heartbeat",
      "x": 0,
      "y": 9,
      "w": 8,
      "h": 3
    },
    {
      "i": "heartbeat_latest",
      "x": 8,
      "y": 9,
      "w": 2,
      "h": 3
    },
    {
      "i": "jumps",
      "x": 10,
      "y": 9,
      "w": 2,
      "h": 3
    },
    {
      "i": "memory_auditor_cycles",
      "x": 0,
      "y": 12,
      "w": 4,
      "h": 3
    },
    {
      "i": "memory_auditor_errors",
      "x": 4,
      "y": 12,
      "w": 4,
      "h": 3
    },
    {
      "i": "memory_auditor_top_memories",
      "x": 8,
      "y": 12,
      "w": 4,
      "h": 3
    }
  ]
}
