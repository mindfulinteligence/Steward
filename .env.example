# Local development environment for Steward ACS
# Copy to .env and edit before running: cp .env.example .env
# docker compose up -d

# ─── LLM Providers (at least one needed for memory auditing) ─────────────────
# Without these, memories won't be auto-audited (Audit failed: :no_providers_enabled)
# NIM_API_KEY=
# MIMO_API_KEY=
# MINIMAX_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=
# OPENROUTER_MODEL=

# ─── Per-location, per-call-type LLM routing (Acs.LLM.Router) ────────────────
# Override the provider priority list and/or model for a given call type and
# deployment region. Priority precedence (highest first): LLM_PRIORITY_<REGION>_<CALLTYPE>
# > LLM_PRIORITY_<CALLTYPE> > LLM_PRIORITY_<REGION> > built-in map > default.
# Call types: intake, skill_intake, memory_audit, skill_audit, spec_audit.
# Example — route intake to the dedicated OpenRouter provider (DeepSeek V4 Flash)
# for <2s agent feedback:
#   ACS_REGION=default
#   LLM_PRIORITY_INTAKE=openrouter
#   OPENROUTER_API_KEY=<openrouter key>
#   # optional overrides:
#   OPENROUTER_MODEL=deepseek/deepseek-4-flash
# ACS_REGION=default
# LLM_PRIORITY_INTAKE=
# LLM_PRIORITY_SKILL_INTAKE=
# LLM_MODEL_INTAKE=

# ─── Memory Auditor Evaluation Prompt ────────────────────────────────────────
# Load the LLM evaluation prompt from a file (supports {{memory_json}} and
# {{existing_memories_json}} template variables). Falls back to hardcoded default.
# MEMORY_EVALUATION_PROMPT_PATH=/etc/steward/prompts/evaluate.md

# ─── Memory Auditor Pre-filter Rules ─────────────────────────────────────────
# Comma-separated patterns for auto-rejection of proposed memories.
# AUDITOR_INTERVAL=30000
# AUDITOR_MAX_CONCURRENCY=20
# AUDITOR_REJECT_TITLE_PREFIXES=Key learning from task,Issue encountered in task
# AUDITOR_REJECT_TITLE_EXACT=Improvement suggestion from task feedback
# AUDITOR_REJECT_SCOPE_PREFIXES=test/,test_app/
# AUDITOR_REJECT_ID_PREFIXES=lifecycle_rebuild
# AUDITOR_REJECT_ID_CONTAINS=guidance_test,e2e_pipeline,test_hybrid
# AUDITOR_MIN_CONTENT_LENGTH=20
# AUDITOR_LOW_CONTENT_LENGTH=50
# AUDITOR_FUZZY_THRESHOLD=0.85
# AUDITOR_REJECT_EMPTY_SCOPE=true
# AUDITOR_REJECT_TITLE_EQUALS_CONTENT=true

# ─── MCP Tools Path ──────────────────────────────────────────────────────────
# Point to your YAML tool definitions directory (comma-separated for multiple dirs)
# Default: /app/acs/acstools (inside container)
# MCP_TOOLS_PATH=./acstools

# ─── Dashboard auth (local single-tenant) ────────────────────────────────────
# Local uses username/password. Auth0 OIDC is multi-tenant prod only.
# ACS_USERNAME=admin
# ACS_PASSWORD=admin
# ACCOUNT_HOST=localhost
# OIDC_BROWSER_ENABLED=false

# ─── Dashboard OAuth (Auth0 Regular Web Application) — multi-tenant prod ─────
# OIDC_BROWSER_ENABLED=true
# AUTH0_WEB_CLIENT_ID=
# AUTH0_WEB_CLIENT_SECRET=
# AUTH0_WEB_REDIRECT_URI=https://prod.stewardacs.xyz/auth/callback
# ACCOUNT_HOST=prod.stewardacs.xyz
# Allow verified, orgless OAuth users to create an organization.
# SELF_SERVICE_ORGS_ENABLED=false

# ─── Multi-tenant ────────────────────────────────────────────────────────────
# Set MULTI_TENANT=true via docker-compose.multitenant.yml. Requires BASE_DOMAIN.
# See .env.multitenant and guides/deployment.md / priv/skills/deployment.md.
# MULTI_TENANT=false
# BASE_DOMAIN=stewardacs.xyz
# ACS_ORG_NAME=default
# ORGS_FILE=/path/to/orgs.json

# ─── MCP Auth ────────────────────────────────────────────────────────────────
# MCP_API_KEY=
# SERVICE_API_KEY=
# MCP_QUERY_KEY_AUTH=false

# ─── MCP OAuth (Auth0) — MULTI_TENANT only ───────────────────────────────────
# Requires MULTI_TENANT=true. Single-tenant boot raises if this is true.
# Local / single-tenant coding uses MCP_API_KEY (x-api-key), not Auth0 OAuth.
# OAUTH_BEARER_ENABLED=false
# AUTH0_DOMAIN=dev-jw5wgp2b.us.auth0.com
# AUTH0_AUDIENCE=https://prod.stewardacs.xyz/mcp/sse
# MCP_PUBLIC_URL=https://prod.stewardacs.xyz
# MCP_RESOURCE_URL=https://prod.stewardacs.xyz/mcp/sse
# Optional pin (email | google-oauth2). Unset = Auth0 UL choice.
# AUTH0_CONNECTION=

# ─── Production observability (Axiom) ────────────────────────────────────────
# Traces and logs ship only from MIX_ENV=prod and only when AXIOM_LOGS is set.
# Local development never exports, even if these values exist in .env.
# AXIOM_LOGS=
# AXIOM_DATASET=steward_logs
# AXIOM_AGENT_OPS_DATASET=steward_meta_analytics
# AXIOM_METRICS_DATASET=steward-acs-metrics
# AXIOM_METRICS_DATASET=steward-acs-metrics
# AXIOM_DOMAIN=https://us-east-1.aws.edge.axiom.co
# Prod compose hostmetrics sidecar: set COMPOSE_PROFILES=axiom (see .env.multitenant).
# Create Metrics dataset + dashboard: ./scripts/axiom-upsert-server-dashboard.sh

# ─── Email (optional — Resend, remote/prod only) ──────────────────────────────
# Local never needs this. On remote, set both to email organization invitations.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Steward ACS <noreply@yourdomain.com>

# ─── Meta-Harness (analysis & reporting) ─────────────────────────────────────
# Buffers tool ops in acs_tool_operations + hourly Analyzer rollups.
# Prod: enable and ship to AXIOM_AGENT_OPS_DATASET (steward_meta_analytics) as
# message meta.summary / meta.tool / meta.error_cluster / meta.agent.
# Local also writes markdown under metaanalysis/ when the dir is writable.
# META_HARNESS_ENABLED=true

# ─── Org ───────────────────────────────────────────────────────────────────────
# ACS_ORG_NAME=default
# Local coding identity for shared MCP_API_KEY (Active Agents name). Same idea as
# an acs_dev_ key's developer_name in prod. Prefer Settings → Coding identity or
# bin/setup.sh; "unknown" falls back to pool names (Alice/Yara/…).
# ACS_DEVELOPER_NAME=Nahar
# ACS_PROJECT_NAME=
