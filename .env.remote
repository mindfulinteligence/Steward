# Remote production deployment
# Copy to .env and fill in values before:
#   docker compose -f docker-compose.remote.yml up -d --build

# ─── Required ───────────────────────────────────────────────────────────────
DOMAIN=steward.example.com
PHX_HOST=steward.example.com
SECRET_KEY_BASE=
MCP_API_KEY=
SERVICE_API_KEY=
DB_PASSWORD=

# Dashboard Auth0 Regular Web Application
ACCOUNT_HOST=steward.example.com
OIDC_BROWSER_ENABLED=true
AUTH0_WEB_CLIENT_ID=
AUTH0_WEB_CLIENT_SECRET=
AUTH0_WEB_REDIRECT_URI=https://steward.example.com/auth/callback
SELF_SERVICE_ORGS_ENABLED=false

# Session cookie signing uses a fixed versioned salt in code (acs_cookie_v1).
# LiveView signing_salt is derived from SECRET_KEY_BASE or SESSION_SIGNING_SALT at runtime.
# SESSION_SIGNING_SALT=

# ─── Database ─────────────────────────────────────────────────────────────────
DB_USER=postgres
DB_NAME=acs_prod

# ─── Dashboard / org ─────────────────────────────────────────────────────────
ACS_ORG_NAME=default
ACS_DEVELOPER_NAME=unknown

# ─── MCP / logging ───────────────────────────────────────────────────────────
LOG_INGEST_KEY=
MCP_QUERY_KEY_AUTH=false

# ─── MCP OAuth (Auth0) — MULTI_TENANT only ───────────────────────────────────
# Single-tenant boot raises if OAUTH_BEARER_ENABLED=true.
# For Claude Connectors use MULTI_TENANT (docker-compose.multitenant.yml).
# API keys (MCP_API_KEY / acs_dev_...) work for Claude Code and plugins here.
OAUTH_BEARER_ENABLED=false
# AUTH0_DOMAIN=dev-jw5wgp2b.us.auth0.com
# AUTH0_AUDIENCE=https://steward.example.com/mcp/sse
# MCP_PUBLIC_URL=https://steward.example.com
# MCP_RESOURCE_URL=https://steward.example.com/mcp/sse
# Optional override (defaults to https://${AUTH0_DOMAIN}/)
# AUTH0_ISSUER=https://dev-jw5wgp2b.us.auth0.com/

# Auth0 connection name for user provisioning — set to a passwordless
# connection (e.g. "email") for magic-link auth, or "Username-Password-Authentication"
# for traditional password-based auth. Defaults to "email" (magic links).
# AUTH0_CONNECTION=email

# ─── Memory ───────────────────────────────────────────────────────────────────
MEMORY_STORE=obsidian
OBSIDIAN_VAULT_PATH=/obsidian
# Override with an absolute path to a custom evaluation prompt file.
# MEMORY_EVALUATION_PROMPT_PATH=/app/priv/prompts/memory/evaluate.md

# ─── Syncthing (Obsidian vault sync) ───────────────────────────────────────────
# Single-tenant (docker-compose.remote.yml): one container, one key.
STGUIAPIKEY=
SYNC_BCRYPT_PASS=
SYNC_USERNAME=syncuser
OBSIDIAN_DOMAIN=obsidian.steward.xyz

# ─── LLM providers (optional) ─────────────────────────────────────────────────
ENABLED_LLM_PROVIDERS=
TOKENROUTER_API_KEY=
NIM_API_KEY=
# NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
MINIMAX_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
TOKENROUTER_MODEL=z-ai/glm-5.3-free
OLLAMA_URL=

# ─── Email (optional — Resend) ────────────────────────────────────────────────
# Invitation email for remote/prod only. Local never requires these.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Steward ACS <noreply@stewardacs.xyz>

# ─── Meta-harness (analysis & reporting) ─────────────────────────────────────
META_HARNESS_ENABLED=true

# ─── Security / network (optional) ───────────────────────────────────────────
# Comma-separated allowed browser origins for CORS (defaults to wildcard in config.exs)
# CORS_ORIGINS=https://steward.example.com
# BRIDGE_ALLOWED_HOSTS=internal-service,api.example.com
