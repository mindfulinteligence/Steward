<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px;">
  <div class="card" style="width: 100%; max-width: 420px; padding: 32px;">
    <div class="section-header" style="margin-bottom: 24px;">
      <div>
        <h1 class="section-title" style="font-size: 1.5rem;">Steward</h1>
        <p class="text-dim" style="margin-top: 8px; font-size: 0.9rem;">Sign in to Steward.</p>
      </div>
    </div>

    <.flash_group flash={@flash} />

    <%= if @oidc_enabled do %>
      <%= if (known_accounts = assigns[:known_accounts] || []) != [] do %>
        <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px;">
          <div class="text-dim" style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em;">Continue as</div>
          <%= for account <- known_accounts do %>
            <a
              href={account["url"]}
              style="display: flex; flex-direction: column; padding: 10px 14px; background: var(--bg-input); border: 1px solid var(--border); border-radius: var(--radius); text-decoration: none;"
            >
              <span style="font-size: 0.85rem; color: var(--text);"><%= account["name"] %></span>
              <span style="font-size: 0.72rem; color: var(--muted);"><%= account["email"] %></span>
            </a>
          <% end %>
        </div>
        <div class="text-dim" style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px;">Or sign in with another account</div>
      <% end %>
      <a href={~p"/auth/log_in"} class="btn btn-primary" style="display: block; width: 100%; text-align: center;">
        Continue with Auth0
      </a>
    <% else %>
      <.form for={%{}} as={:user} action={~p"/users/log_in"} method="post" style="display: flex; flex-direction: column; gap: 16px;">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <div>
          <label for="user_username" class="text-dim" style="display: block; font-size: 0.75rem; margin-bottom: 8px; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.06em;">Username</label>
          <input
            type="text"
            name="user[username]"
            id="user_username"
            required
            autocomplete="username"
            placeholder="admin"
            style="width: 100%; padding: 12px 14px; background: var(--bg-input); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); font-family: var(--font-body);"
          />
        </div>
        <div>
          <label for="user_password" class="text-dim" style="display: block; font-size: 0.75rem; margin-bottom: 8px; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.06em;">Password</label>
          <input
            type="password"
            name="user[password]"
            id="user_password"
            required
            autocomplete="current-password"
            style="width: 100%; padding: 12px 14px; background: var(--bg-input); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); font-family: var(--font-body);"
          />
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%;">Sign in</button>
      </.form>
    <% end %>
  </div>
</div>
